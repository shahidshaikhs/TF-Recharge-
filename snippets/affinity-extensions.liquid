{%- comment -%}
  Affinity portal hub snippet — single entry point for all Recharge portal customizations.
  Rendered only on /tools/recurring pages (guarded in layout/theme.liquid).

  Current extensions:
  - "Did you know" custom_extension data bridge (metaobject: did_you_know_upcoming_orders)
  - FAQ accordion (schedule.footer slot, metaobject: faq_recharge_footer)
  - Alert banner (upcoming_orders.header slot, metaobject: alert_recharge)
{%- endcomment -%}

{%- comment -%} === 1. Portal CSS === {%- endcomment -%}

<style>
  .cf-did-you-know {
    background-color: #E6F0F8;
    border-radius: 8px;
    overflow: hidden;
  }

  .cf-did-you-know__text-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 20px 16px;
  }

  .cf-did-you-know__heading {
    display: flex;
    flex-direction: row;
    gap: 24px;
  }

  .cf-did-you-know__heading-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    min-width: 0;
    padding-top: 8px;
  }

  .cf-did-you-know__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.56px;
    text-transform: uppercase;
    color: #202635;
    margin: 0;
  }

  .cf-did-you-know__headline {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 22px;
    color: #202635;
    margin: 0;
  }

  .cf-did-you-know__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .cf-did-you-know__icon svg {
    width: 40px;
    height: 40px;
    display: block;
  }

  .cf-did-you-know__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid #202635;
    padding-bottom: 4px;
    text-decoration: none;
    color: #202635;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 20px;
    align-self: flex-start;
  }

  .cf-did-you-know__cta-arrow {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 16px;
    height: 16px;
    font-size: 11px;
    line-height: 13px;
    font-weight: 500;
  }

  .cf-did-you-know + .cf-articles {
    margin-block-start: 32px;
  }

  .cf-articles__scroll {
    display: flex;
    flex-direction: row;
    gap: 10px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .cf-articles__scroll::-webkit-scrollbar {
    display: none;
  }

  .cf-articles__card {
    flex: 0 0 312px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #E6F0F8;
    display: flex;
    flex-direction: column;
  }

  .cf-articles__image {
    display: block;
    width: 100%;
    aspect-ratio: 312 / 175;
    object-fit: cover;
  }

  .cf-articles__text-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: space-between;
    padding: 12px 16px 16px 16px;
    flex: 1;
  }

  .cf-articles__heading-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: flex-end;
    padding-top: 8px;
  }

  .cf-articles__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.56px;
    text-transform: uppercase;
    color: #202635;
    margin: 0;
  }

  .cf-articles__headline {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 25px;
    color: #202635;
    margin: 0;
  }

  .cf-articles__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid #202635;
    padding-bottom: 4px;
    text-decoration: none;
    color: #202635;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    align-self: flex-start;
  }

  .cf-articles__link:hover {
    opacity: 0.7;
  }

  .cf-articles__link-arrow {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 16px;
    height: 16px;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 11px;
    line-height: 13px;
  }

  /* --- FAQ accordion (schedule.footer slot) --- */

  .cf-faq {
    background-color: #FFFFFF;
    padding: 16px;
    margin-block-start: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cf-faq__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 36px;
    line-height: 47px;
    letter-spacing: -0.36px;
    color: #000000;
    margin: 0;
  }

  .cf-faq__list {
    display: flex;
    flex-direction: column;
  }

  .cf-faq__item {
    border-top: 1px solid #E5E5E5;
  }

  .cf-faq__item:last-child {
    border-bottom: 1px solid #E5E5E5;
  }

  .cf-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    list-style: none;
    cursor: pointer;
  }

  .cf-faq__question::-webkit-details-marker {
    display: none;
  }

  .cf-faq__question-text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 20px;
    line-height: 26px;
    letter-spacing: -0.2px;
    color: #202635;
    margin: 0;
  }

  .cf-faq__chevron {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .cf-faq__item[open] .cf-faq__chevron {
    transform: rotate(180deg);
  }

  .cf-faq__answer {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    color: #202635;
    margin: 0;
    padding-bottom: 24px;
  }

  /* --- Alert banner (upcoming_orders.header slot) --- */

  .cf-alert {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 20px 19px;
    background-color: #F8EDE0;
    border: 1px solid #ED7C5C;
    border-radius: 16px;
    margin-block-end: 32px;
  }

  .cf-alert__icon-row {
    display: flex;
    flex-direction: row;
    gap: 4px;
    align-items: center;
  }

  .cf-alert__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .cf-alert__heading {
    font-family: var(--font-heading--family, sans-serif);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.14px;
    color: #202635;
    margin: 0;
  }

  .cf-alert__description {
    font-family: var(--font-body--family, sans-serif);
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.12px;
    color: #202635;
    margin: 0;
  }
</style>

{%- comment -%} === 2. Slot templates === {%- endcomment -%}

{%- liquid
  assign dyk_sub = shop.metaobjects.did_you_know_subscriptions_footer.values | first
  assign articles_wrapper = shop.metaobjects.articles_recharge_subscription_footer.values | first
  assign faq_wrapper = shop.metaobjects.faq_recharge_footer.values | first
-%}

{%- if dyk_sub != blank or articles_wrapper != blank -%}
  <script type="text/html" data-recharge-slot="subscriptions.footer">
    {%- if dyk_sub != blank -%}
      <div class="cf-did-you-know">
        <div class="cf-did-you-know__text-lockup">
          <div class="cf-did-you-know__heading">
            <div class="cf-did-you-know__heading-lockup">
              {%- if dyk_sub.eyebrow.value != blank -%}
                <span class="cf-did-you-know__eyebrow">{{ dyk_sub.eyebrow.value }}</span>
              {%- endif -%}
              {%- if dyk_sub.headline.value != blank -%}
                <p class="cf-did-you-know__headline">{{ dyk_sub.headline.value | newline_to_br }}</p>
              {%- endif -%}
            </div>
            <div class="cf-did-you-know__icon">
              {{ 'icon.svg' | inline_asset_content }}
            </div>
          </div>
          {%- if dyk_sub.cta_label.value != blank and dyk_sub.cta_url.value != blank -%}
            <a href="{{ dyk_sub.cta_url.value }}" class="cf-did-you-know__cta">
              {{ dyk_sub.cta_label.value }}
              <span class="cf-did-you-know__cta-arrow">→</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- if articles_wrapper != blank and articles_wrapper.article.value != blank -%}
      <div class="cf-articles">
        <div class="cf-articles__scroll">
          {%- for article in articles_wrapper.article.value -%}
            <article class="cf-articles__card">
              {%- if article.image.value != blank -%}
                <img
                  src="{{ article.image.value | image_url: width: 624 }}"
                  alt="{{ article.eyebrow.value | default: '' | escape }}"
                  class="cf-articles__image"
                  loading="lazy"
                  width="312"
                  height="175"
                >
              {%- endif -%}
              <div class="cf-articles__text-lockup">
                <div class="cf-articles__heading-lockup">
                  {%- if article.eyebrow.value != blank -%}
                    <span class="cf-articles__eyebrow">{{ article.eyebrow.value }}</span>
                  {%- endif -%}
                  {%- if article.headline.value != blank -%}
                    <p class="cf-articles__headline">{{ article.headline.value | newline_to_br }}</p>
                  {%- endif -%}
                </div>
                {%- if article.link_label.value != blank and article.link_url.value != blank -%}
                  <a href="{{ article.link_url.value }}" class="cf-articles__link">
                    {{ article.link_label.value }}
                    <span class="cf-articles__link-arrow">&#8594;</span>
                  </a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </script>
{%- endif -%}

{%- if faq_wrapper != blank -%}
  <script type="text/html" data-recharge-slot="schedule.footer">
    <div class="cf-faq">
      {%- if faq_wrapper.title.value != blank -%}
        <h2 class="cf-faq__title">{{ faq_wrapper.title.value }}</h2>
      {%- endif -%}
      {%- if faq_wrapper.faq.value != blank -%}
        <div class="cf-faq__list">
          {%- for item in faq_wrapper.faq.value -%}
            {%- if item.question.value != blank -%}
              <details class="cf-faq__item">
                <summary class="cf-faq__question">
                  <span class="cf-faq__question-text">{{ item.question.value }}</span>
                  <svg class="cf-faq__chevron" width="16" height="9" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L8 8L15 1" stroke="#202635" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                {%- if item.answer.value != blank -%}
                  <div class="cf-faq__answer">{{ item.answer.value | newline_to_br }}</div>
                {%- endif -%}
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </script>
{%- endif -%}

{%- liquid
  assign alert = shop.metaobjects.alert_recharge.values | first
-%}

{%- if alert != blank -%}
  <script type="text/html" data-recharge-slot="upcoming_orders.header">
    <div class="cf-alert">
      {%- if alert.heading.value != blank -%}
        <div class="cf-alert__icon-row">
          <span class="cf-alert__icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.5 2C6.5 1.17 7.17 0.5 8 0.5C8.83 0.5 9.5 1.17 9.5 2L9 9C9 9.55 8.55 10 8 10C7.45 10 7 9.55 7 9L6.5 2ZM8 11.5C7.17 11.5 6.5 12.17 6.5 13C6.5 13.83 7.17 14.5 8 14.5C8.83 14.5 9.5 13.83 9.5 13C9.5 12.17 8.83 11.5 8 11.5Z" fill="#ED7C5C"/></svg>
          </span>
          <p class="cf-alert__heading">{{ alert.heading.value }}</p>
        </div>
      {%- endif -%}
      {%- if alert.description.value != blank -%}
        <p class="cf-alert__description">{{ alert.description.value | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </script>
{%- endif -%}

{%- comment -%} === 3. Data output scripts === {%- endcomment -%}

{%- liquid
  assign dyk = shop.metaobjects.did_you_know_upcoming_orders.values | first
-%}

{%- if dyk != blank -%}
  <script type="application/json" id="cf-did-you-know-data">
    {
      {%- if dyk.image.value != blank -%}
        "image": {{ dyk.image.value | image_url: width: 720 | json }},
      {%- endif -%}
      "eyebrow": {{ dyk.eyebrow.value | default: "" | json }},
      "heading": {{ dyk.heading.value | default: "" | json }},
      "link_label": {{ dyk.link_label.value | default: "" | json }},
      "link_url": {{ dyk.link_url.value | default: "" | json }}
    }
  </script>
{%- endif -%}

{%- comment -%} === 4. Portal JS (custom_extension manages its own lifecycle — no JS needed here) === {%- endcomment -%}
