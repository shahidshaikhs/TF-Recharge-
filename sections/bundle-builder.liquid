{% liquid
  assign product = section.settings.product
  assign heading_text = section.settings.heading_text
  assign columns_desktop = section.settings.products_per_row
  assign columns_mobile = section.settings.mobile_products_per_row
%}

<bundle-builder-section
  class="bundle-builder color-{{ section.settings.color_scheme }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-heading-text="{{ heading_text }}"
  data-columns-desktop="{{ columns_desktop }}"
  data-columns-mobile="{{ columns_mobile }}"
  style="
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="bundle-builder__wrapper page-width" ref="mainContent">
    <div class="bundle-builder__main">
      <h2 class="bundle-builder__heading" ref="heading">{{ heading_text }}</h2>
      <div class="bundle-builder__tabs" ref="collectionTabs"></div>
      <div class="bundle-builder__grid" ref="productGrid">
        <div class="bundle-builder__loading">Loading bundle products...</div>
      </div>
    </div>
    <div class="bundle-builder__rail">
      <div class="bundle-builder__rail-inner">
        <div ref="frequencySelector"></div>
        <div ref="sizeSelector"></div>
        <div ref="progress"></div>
        <div ref="selectionsList"></div>
        <div ref="subtotal"></div>
        <div ref="addToCartWrap">
          <button class="button bundle-builder__add-to-cart" type="button" disabled>Add to Cart</button>
        </div>
      </div>
    </div>
  </div>
  <div class="bundle-builder__quick-view-drawer" ref="quickViewDrawer"></div>
</bundle-builder-section>

<script
  src="{{ 'bundle-builder.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% stylesheet %}
  .bundle-builder {
    padding-block-start: var(--padding-block-start, 40px);
    padding-block-end: var(--padding-block-end, 80px);
  }

  .bundle-builder__wrapper {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .bundle-builder__main {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .bundle-builder__heading {
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: rgb(var(--color-foreground));
    text-transform: uppercase;
  }

  /* Collection tabs */
  .bundle-builder__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bundle-builder__tab {
    padding: 8px 20px;
    border: 1px solid rgb(var(--color-foreground) / 0.2);
    border-radius: 999px;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .bundle-builder__tab:hover {
    background: rgb(var(--color-foreground) / 0.05);
  }

  .bundle-builder__tab--active {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }

  /* Product grid */
  .bundle-builder__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 2), 1fr);
    gap: 16px;
  }

  .bundle-builder__product-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bundle-builder__product-image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 1 / 1;
    background: rgb(var(--color-foreground) / 0.04);
  }

  .bundle-builder__product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bundle-builder__product-image-placeholder {
    width: 100%;
    height: 100%;
    background: rgb(var(--color-foreground) / 0.08);
  }

  .bundle-builder__quick-view-btn {
    position: absolute;
    inset-block-end: 8px;
    inset-inline-start: 8px;
    padding: 6px 12px;
    font-size: 0.75rem;
    font-family: var(--font-body--family);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgb(var(--color-foreground) / 0.15);
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .bundle-builder__product-card:hover .bundle-builder__quick-view-btn {
    opacity: 1;
  }

  .bundle-builder__product-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .bundle-builder__product-title {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0;
    color: rgb(var(--color-foreground));
    line-height: 1.3;
  }

  .bundle-builder__product-variant {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground) / 0.6);
    margin: 0;
  }

  .bundle-builder__product-price {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground));
    margin: 0;
    font-weight: 500;
  }

  .bundle-builder__product-actions {
    margin-block-start: auto;
  }

  .bundle-builder__add-btn {
    width: 100%;
    font-size: 0.8125rem;
    padding: 8px 12px;
  }

  /* Stepper */
  .bundle-builder__stepper {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(var(--color-foreground) / 0.2);
    border-radius: 6px;
    overflow: hidden;
  }

  .bundle-builder__stepper-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: rgb(var(--color-foreground));
    font-size: 1.125rem;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .bundle-builder__stepper-btn:hover {
    background: rgb(var(--color-foreground) / 0.05);
  }

  .bundle-builder__stepper-qty {
    flex: 1;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    min-width: 40px;
  }

  /* Rail */
  .bundle-builder__rail {
    order: 2;
  }

  .bundle-builder__rail-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    border-radius: 12px;
    background: rgb(var(--color-background));
  }

  .bundle-builder__rail-title {
    font-family: var(--font-heading--family);
    font-size: 0.9375rem;
    font-weight: 700;
    margin: 0 0 12px 0;
    color: rgb(var(--color-foreground));
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Size selector */
  .bundle-builder__size-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid rgb(var(--color-foreground) / 0.15);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.2s;
    margin-block-end: 8px;
    text-align: start;
    color: rgb(var(--color-foreground));
    font-family: var(--font-body--family);
  }

  .bundle-builder__size-card:hover {
    border-color: rgb(var(--color-foreground) / 0.4);
  }

  .bundle-builder__size-card--selected {
    border-color: rgb(var(--color-foreground));
    border-width: 2px;
  }

  .bundle-builder__size-card-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .bundle-builder__size-card-title {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .bundle-builder__size-card-desc {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .bundle-builder__size-card-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .bundle-builder__size-card-price {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .bundle-builder__size-card-count {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  /* Frequency */
  .bundle-builder__frequency {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bundle-builder__freq-option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgb(var(--color-foreground) / 0.15);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    text-align: start;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    color: rgb(var(--color-foreground));
    transition: border-color 0.2s;
  }

  .bundle-builder__freq-option:hover {
    border-color: rgb(var(--color-foreground) / 0.4);
  }

  .bundle-builder__freq-option--selected {
    border-color: rgb(var(--color-foreground));
    border-width: 2px;
  }

  .bundle-builder__freq-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid rgb(var(--color-foreground) / 0.3);
    flex-shrink: 0;
    position: relative;
  }

  .bundle-builder__freq-radio--checked {
    border-color: rgb(var(--color-foreground));
  }

  .bundle-builder__freq-radio--checked::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: rgb(var(--color-foreground));
  }

  .bundle-builder__freq-price {
    margin-inline-start: auto;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .bundle-builder__freq-price s {
    opacity: 0.5;
    font-weight: 400;
  }

  .bundle-builder__freq-intervals {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bundle-builder__freq-intervals-label {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground) / 0.7);
  }

  .bundle-builder__freq-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bundle-builder__freq-pill {
    padding: 6px 16px;
    border: 1px solid rgb(var(--color-foreground) / 0.2);
    border-radius: 999px;
    background: transparent;
    font-size: 0.8125rem;
    font-family: var(--font-body--family);
    cursor: pointer;
    color: rgb(var(--color-foreground));
    transition: background-color 0.15s, border-color 0.15s;
  }

  .bundle-builder__freq-pill:hover {
    border-color: rgb(var(--color-foreground) / 0.4);
  }

  .bundle-builder__freq-pill--selected {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }

  /* Progress */
  .bundle-builder__progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bundle-builder__progress-bar {
    width: 100%;
    height: 8px;
    background: rgb(var(--color-foreground) / 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .bundle-builder__progress-fill {
    height: 100%;
    background: rgb(var(--color-foreground));
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  .bundle-builder__progress-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .bundle-builder__progress-count {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground) / 0.6);
    margin: 0;
  }

  /* Selections */
  .bundle-builder__selections {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 260px;
    overflow-y: auto;
  }

  .bundle-builder__selection-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .bundle-builder__selection-thumb {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .bundle-builder__selection-thumb-placeholder {
    width: 48px;
    height: 48px;
    background: rgb(var(--color-foreground) / 0.08);
    border-radius: 6px;
    flex-shrink: 0;
  }

  .bundle-builder__selection-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .bundle-builder__selection-name {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(var(--color-foreground));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bundle-builder__selection-qty {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground) / 0.6);
  }

  .bundle-builder__selection-remove {
    background: none;
    border: none;
    color: rgb(var(--color-foreground) / 0.5);
    font-size: 0.75rem;
    cursor: pointer;
    text-decoration: underline;
    padding: 4px;
    flex-shrink: 0;
    font-family: var(--font-body--family);
  }

  .bundle-builder__selection-remove:hover {
    color: rgb(var(--color-foreground));
  }

  .bundle-builder__empty-selections {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground) / 0.5);
    margin: 0;
  }

  /* Subtotal */
  .bundle-builder__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block-start: 16px;
    border-block-start: 1px solid rgb(var(--color-foreground) / 0.1);
  }

  .bundle-builder__subtotal-label {
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
  }

  .bundle-builder__subtotal-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
  }

  /* Add to cart */
  .bundle-builder__add-to-cart {
    width: 100%;
  }

  /* Quick view drawer */
  .bundle-builder__quick-view-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
  }

  .bundle-builder__quick-view-drawer--open {
    display: block;
  }

  .bundle-builder__quick-view-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
  }

  .bundle-builder__quick-view-panel {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 0;
    inset-block-end: 0;
    width: 100%;
    max-width: 420px;
    background: rgb(var(--color-background));
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bundle-builder__quick-view-close {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgb(var(--color-foreground));
    z-index: 1;
  }

  .bundle-builder__quick-view-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
  }

  .bundle-builder__quick-view-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bundle-builder__quick-view-title {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .bundle-builder__quick-view-variant {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground) / 0.6);
    margin: 0;
  }

  .bundle-builder__quick-view-price {
    font-size: 1.125rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .bundle-builder__quick-view-actions {
    padding-block: 12px;
  }

  .bundle-builder__quick-view-pdp {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground) / 0.7);
    text-decoration: underline;
  }

  .bundle-builder__quick-view-pdp:hover {
    color: rgb(var(--color-foreground));
  }

  /* Loading & error */
  .bundle-builder__loading {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 0;
    color: rgb(var(--color-foreground) / 0.5);
    font-size: 0.9375rem;
  }

  .bundle-builder__error {
    text-align: center;
    padding: 60px 20px;
    color: rgb(var(--color-foreground) / 0.6);
  }

  .bundle-builder__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 0;
    color: rgb(var(--color-foreground) / 0.5);
  }

  /* Desktop layout */
  @media screen and (min-width: 990px) {
    .bundle-builder__wrapper {
      flex-direction: row;
      gap: 40px;
    }

    .bundle-builder__main {
      flex: 1;
      min-width: 0;
    }

    .bundle-builder__rail {
      width: 360px;
      flex-shrink: 0;
      order: 0;
    }

    .bundle-builder__rail-inner {
      position: sticky;
      top: calc(var(--header-group-height, 80px) + 20px);
      max-height: calc(100vh - var(--header-group-height, 80px) - 40px);
      overflow-y: auto;
    }

    .bundle-builder__grid {
      grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
      gap: 20px;
    }

    .bundle-builder__heading {
      font-size: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle builder",
  "class": "bundle-builder-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Bundle product"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Build Your Box"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_products_per_row",
      "label": "Mobile products per row",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
